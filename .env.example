# Copie para .env e preencha com os dados do painel do Supabase
# (Project Settings → API). Use a chave PÚBLICA (publishable/anon), nunca a secreta.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# ID do cliente OAuth do Google (tipo "Aplicativo da Web"). É público; a chave secreta
# do cliente fica só no painel do Supabase, nunca aqui.
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
